# Replace with this host's trusted LAN IPv4 address.
SONOS_INTERFACE=192.0.2.20

# Defaults to the most recent successful main build. For repeatable deployment,
# set the digest from the GitHub Actions summary after an image is published:
# SONOS_DESK_IMAGE=ghcr.io/mbmackenzie/sonos-desk@sha256:<published-digest>

# Optional MQTT overlay; keep the password in a separate local file.
# SONOS_MQTT_HOST=mqtt.example.test
# SONOS_MQTT_PORT=1883
# SONOS_MQTT_USERNAME=example-app
# SONOS_MQTT_PASSWORD_PATH=/absolute/local/path/sonos-mqtt-password
# SONOS_MQTT_INSTANCE=main
# SONOS_MQTT_POLL_INTERVAL=3
# SONOS_MQTT_TLS=false
